      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">Fundamentals</button>",
      "css": ".ds-filter{padding:8px 14px;border-radius:7px;border:1px solid #1974c7;background:#1974c7;color:white;font-family:Poppins,sans-serif;cursor:pointer}.ds-filter:focus-visible{outline:3px solid var(--vp-c-brand-1,#376ba5);outline-offset:4px}"
