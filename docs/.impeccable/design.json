      "name": "Homepage primary button",
      "kind": "button",
      "refersTo": "home-button",
      "description": "Homepage primary call to action.",
      "html": "<a class=\"ds-home\" href=\"#learn\">Learn MobX <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-home{display:inline-flex;align-items:center;gap:28px;background:var(--mobx-ink,#173b63);color:var(--mobx-paper,#fff);padding:16px 22px;border-radius:10px;font:650 .94rem Poppins,sans-serif;text-decoration:none;transition:transform .18s,background .18s}.ds-home:hover{background:var(--mobx-button-hover,#405872);transform:translateY(-2px)}.ds-home:focus-visible{outline:3px solid var(--vp-c-brand-1,#376ba5);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-home{transition:none}.ds-home:hover{transform:none}}"
    },
    {
      "name": "Run example",
      "kind": "button",
      "refersTo": "gallery-cta",
      "description": "On-demand Flutter example action.",
      "html": "<button class=\"ds-run\">Run example <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 3 14 9-14 9V3Z\"/></svg></button>",
      "css": ".ds-run{display:inline-flex;gap:10px;align-items:center;padding:12px 20px;border:0;border-radius:8px;background:#1974c7;color:white;font:600 14px Poppins,sans-serif;cursor:pointer}.ds-run svg{transition:transform .2s ease-out}.ds-run:hover svg,.ds-run:focus-visible svg{transform:translateX(4px)}.ds-run:focus-visible{outline:3px solid #63a6e4;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-run svg{transition:none;transform:none!important}}"
    },
