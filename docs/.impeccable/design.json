      "html": "<a class=\"ds-row\" href=\"#counter\"><span><strong>Start with a counter</strong><small>Observable + Action + Observer</small></span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-row{display:flex;align-items:center;gap:22px;padding:25px 4px;border-bottom:1px solid var(--mobx-line,#e0e5e9);color:var(--mobx-ink,#173b63);text-decoration:none}.ds-row strong{font:600 21px \"Chakra Petch\",sans-serif}.ds-row small{display:block;margin-top:6px;color:var(--mobx-muted,#536e8b);font:14px Poppins,sans-serif}.ds-row svg{margin-left:auto;transition:transform .2s ease-out}.ds-row:hover strong{color:var(--vp-c-brand-1,#376ba5)}.ds-row:hover svg,.ds-row:focus-visible svg{transform:translateX(4px)}.ds-row:focus-visible{outline:3px solid var(--vp-c-brand-1,#376ba5);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-row svg{transition:none;transform:none!important}}"
