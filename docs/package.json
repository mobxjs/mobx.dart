{
  "name": "mobx-dart-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vitepress dev --host localhost --port 4178 --strictPort",
    "start": "pnpm dev",
    "build": "node scripts/build-flutter.mjs && node scripts/api-reference.mjs && node scripts/prepare.mjs && vitepress build",
    "serve": "vitepress preview --host localhost --port 4178 --strictPort",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build:flutter": "node scripts/build-flutter.mjs",
    "build:docs": "node scripts/api-reference.mjs && node scripts/prepare.mjs && vitepress build"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@lucide/vue": "^1.44.0"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3"
  },
  "packageManager": "pnpm@12.3.4"
}
